# Supabase (https://supabase.com) — copier vers .env.local et remplir
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Optionnel : opérations serveur sensibles (jamais exposé au client)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Paiement réel Stripe — désactivé tant que vide (aucune simulation silencieuse)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Back-office /admin — désactivé tant que vide (voir docs/research/maje/paiements-admin.md)
ADMIN_TOKEN=
# Emails transactionnels (Resend) — sans clé, les envois sont journalisés uniquement
RESEND_API_KEY=
